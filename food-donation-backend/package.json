{
  "name": "food-donation-backend",
  "version": "1.0.0",
  "description": "খাদ্য দান ব্যবস্থাপনা সিস্টেম - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --watchAll=false",
    "seed": "node scripts/seedData.js",
    "migrate": "node scripts/migrate.js",
    "reset-db": "node scripts/resetDatabase.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "cors": "^2.8.5",
    "helmet": "^6.0.1",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.14.3",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^1.35.0",
    "nodemailer": "^6.9.1",
    "dotenv": "^16.0.3",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "redis": "^4.6.5",
    "socket.io": "^4.6.1",
    "bull": "^4.10.4",
    "cron": "^2.2.0",
    "moment": "^2.29.4",
    "validator": "^13.9.0",
    "slugify": "^1.6.5",
    "crypto": "^1.0.1",
    "sharp": "^0.32.0",
    "csv-parse": "^5.3.6",
    "xlsx": "^0.18.5",
    "puppeteer": "^19.7.2",
    "express-slow-down": "^1.6.0",
    "express-mongo-sanitize": "^2.2.0",
    "xss-clean": "^0.1.1",
    "hpp": "^0.2.3"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^8.12.0",
    "eslint": "^8.36.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "prettier": "^2.8.4",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.2",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "food-donation",
    "mern-stack",
    "express",
    "mongodb",
    "nodejs",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!tests/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}